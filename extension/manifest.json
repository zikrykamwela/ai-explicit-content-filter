{
  "manifest_version": 3,
  "name": "ClearView Content Filter",
  "version": "1.0.0",
  "description": "Detect and hide explicit images in browser pages using the local AI classifier.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>", "http://localhost:5000/*", "http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ClearView Content Filter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
